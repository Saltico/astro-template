---
// src/layouts/PostLayout.astro
// Layout for blog posts / articles (extends BaseLayout)

import BaseLayout from './BaseLayout.astro';
import type { BreadcrumbItem } from '@/types/seo';
import { blogPostingSchema, getSiteUrl } from '@/lib/seo';
import JsonLd from '@/components/seo/JsonLd.astro';

export interface Props {
  title: string;
  description: string;
  date: string;
  image?: string;
}

const { title, description, date, image } = Astro.props;

const canonical = getSiteUrl(Astro.url.pathname);
const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', url: '/' },
  { label: 'Blog', url: '/blog' },
  { label: title },
];

const jsonLd = blogPostingSchema(title, description, canonical, date, image);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={image}
  breadcrumbs={breadcrumbs}
>
  <article class="post">
    <header class="post__header">
      <h1 class="post__title">{title}</h1>
      <time class="post__date" datetime={date}>
        {new Date(date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </header>

    <div class="post__content">
      <slot />
    </div>
  </article>

  <JsonLd data={jsonLd} />
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin-inline: auto;
    padding-block: var(--spacing-12);
    padding-inline: var(--spacing-4);
  }

  @media (min-width: 768px) {
    .post {
      padding-inline: var(--spacing-8);
    }
  }

  .post__header {
    margin-bottom: var(--spacing-8);
    text-align: center;
  }

  .post__title {
    font-size: var(--text-h1);
    margin-bottom: var(--spacing-4);
  }

  .post__date {
    font-size: var(--text-small);
    color: var(--color-ink-500);
  }

  .post__content {
    font-size: var(--text-body);
    line-height: 1.7;
  }

  .post__content :global(h2) {
    font-size: var(--text-h3);
    margin-top: var(--spacing-8);
    margin-bottom: var(--spacing-4);
  }

  .post__content :global(h3) {
    font-size: var(--text-h4);
    margin-top: var(--spacing-6);
    margin-bottom: var(--spacing-3);
  }

  .post__content :global(p) {
    margin-bottom: var(--spacing-4);
  }

  .post__content :global(ul),
  .post__content :global(ol) {
    margin-bottom: var(--spacing-4);
    padding-left: var(--spacing-6);
  }

  .post__content :global(li) {
    margin-bottom: var(--spacing-2);
  }

  .post__content :global(blockquote) {
    margin-block: var(--spacing-6);
    padding-left: var(--spacing-6);
    border-left: 4px solid var(--color-brand);
    font-style: italic;
    color: var(--color-ink-700);
  }

  .post__content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin-block: var(--spacing-6);
  }
</style>
