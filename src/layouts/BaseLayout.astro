---
// src/layouts/BaseLayout.astro
// Canonical layout for the entire site. All shared data imported from
// @/data/site.ts and distributed to components via props.

import '@/styles/base.css';
import type { NavItem } from '@/types/navigation';
import type { FooterColumn, FooterLink, SocialLink } from '@/types/layout';
import type { BreadcrumbItem } from '@/types/seo';
import SkipLink from '@/components/layout/SkipLink.astro';
import TopBar from '@/components/layout/TopBar.astro';
import Header from '@/components/layout/Header.astro';
import Navigation from '@/components/layout/Navigation.astro';
import Footer from '@/components/layout/Footer.astro';
import SEO from '@/components/seo/SEO.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import GTM from '@/components/analytics/GTM.astro';
import GA4 from '@/components/analytics/GA4.astro';
import ConsentBanner from '@/components/analytics/ConsentBanner.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { organizationSchema, websiteSchema, getSiteUrl } from '@/lib/seo';
import { siteBrand, siteContact, siteLanguage, topbarData, navigationData, footerData } from '@/data/site';
import { initAnalytics } from '@/lib/analytics';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: string;
  showTopBar?: boolean;
  showHeader?: boolean;
  showFooter?: boolean;
  topbar?: {
    phone?: string;
    email?: string;
    social?: SocialLink[];
    links?: Array<{ label: string; url: string }>;
  };
  navigation?: {
    items: NavItem[];
    ariaLabel?: string;
  };
  footer?: {
    columns: FooterColumn[];
    legal: FooterLink[];
    brand: string;
    description?: string;
    phone?: string;
    email?: string;
    address?: string;
    schedule?: string;
    social?: SocialLink[];
    logoUrl?: string;
    logoAlt?: string;
    siteUrl?: string;
  };
  headerVariant?: 'default' | 'brand';
  immersive?: boolean;
}

const {
  title,
  description,
  canonical: canonicalProp,
  ogImage,
  noindex = false,
  breadcrumbs,
  jsonLd,
  lang: pageLang,
  showTopBar = true,
  showHeader = true,
  showFooter = true,
  topbar = topbarData,
  navigation,
  footer,
  headerVariant = 'default',
  immersive = false,
} = Astro.props;

const canonical = canonicalProp ?? getSiteUrl(Astro.url.pathname);
const htmlLang = pageLang ?? siteLanguage;

// Analytics IDs from env vars
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const ga4Id = import.meta.env.PUBLIC_GA4_ID;

// Footer derived from site.ts; override (if exists) wins.
const effectiveFooter = {
  columns: footer?.columns ?? footerData.columns,
  legal: footer?.legal ?? footerData.legal,
  brand: footer?.brand ?? siteBrand.name,
  description: footer?.description ?? siteBrand.description,
  phone: footer?.phone ?? siteContact.phone,
  email: footer?.email ?? siteContact.email,
  address: footer?.address ?? siteContact.address,
  schedule: footer?.schedule ?? siteContact.schedule,
  social: footer?.social ?? topbarData.social,
  logoUrl: footer?.logoUrl ?? siteBrand.logoUrl,
  logoAlt: footer?.logoAlt ?? siteBrand.name,
  siteUrl: footer?.siteUrl ?? siteBrand.siteUrl,
};

const navItems = navigation?.items ?? navigationData;

const bodyClasses = [
  !showTopBar && 'topbar-hidden',
  immersive && 'immersive-hero',
].filter(Boolean).join(' ') || undefined;

// Base JSON-LD schemas injected on every page
const baseSchemas = [organizationSchema(), websiteSchema()];
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [...baseSchemas, ...pageSchemas];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Consent Mode defaults (before analytics) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
    </script>

    <!-- Google Tag Manager (conditional) -->
    {gtmId && <GTM gtmId={gtmId} />}

    <!-- Google Analytics 4 (conditional) -->
    {ga4Id && <GA4 ga4Id={ga4Id} />}

    <!-- SEO component (INMUTABLE — do not modify) -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={allSchemas}
      lang={htmlLang}
    />

    <!-- Preload critical fonts (self-hosted, subset latin) -->
    <link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script>
      // 1. Anti-FOUC: apply theme before first paint
      (function() {
        const s = localStorage.getItem('theme-preference');
        const t = s === 'dark' || s === 'light' ? s : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
      })();

      // 2. Intersection Observer for reveal animations
      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
        );

        document.querySelectorAll('.reveal, .reveal-up, .reveal-scale').forEach((el) => {
          revealObserver.observe(el);
        });
      }
    </script>

    <slot name="head" />
  </head>
  <body class={bodyClasses}>
    <!-- Consent Banner -->
    {(gtmId || ga4Id) && <ConsentBanner />}

    <SkipLink targetId="main-content" />

    {showTopBar && <TopBar phone={topbar.phone} email={topbar.email} social={topbar.social} links={topbar.links} />}

    {
      showHeader && (
        <Header variant={headerVariant}>
          <a href="/" slot="logo" class="header-logo" aria-label={`${siteBrand.name} - Home`}>
            <img
              src={siteBrand.logoUrl}
              alt={siteBrand.name}
              width={200}
              height={48}
              class="header-logo__img"
              loading="eager"
              decoding="async"
            />
          </a>
          <Navigation slot="navigation" items={navItems} aria-label={navigation?.ariaLabel} variant="default">
            <ThemeToggle slot="mobile-actions" />
          </Navigation>
          <Fragment slot="cta">
            <ThemeToggle />
          </Fragment>
        </Header>
      )
    }

    <main id="main-content" tabindex="-1">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <slot />
    </main>

    {
      showFooter && (
        <Footer
          columns={effectiveFooter.columns}
          legal={effectiveFooter.legal}
          brand={effectiveFooter.brand}
          description={effectiveFooter.description}
          phone={effectiveFooter.phone}
          email={effectiveFooter.email}
          address={effectiveFooter.address}
          schedule={effectiveFooter.schedule}
          social={effectiveFooter.social}
          logoUrl={effectiveFooter.logoUrl}
          logoAlt={effectiveFooter.logoAlt}
          siteUrl={effectiveFooter.siteUrl}
        />
      )
    }

    <script>
      // Initialize analytics: listens to DOM events and sends to GTM dataLayer
      initAnalytics();
    </script>
  </body>
</html>

<style>
  .header-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .header-logo__img {
    width: auto;
    height: 2.25rem;
    max-width: 100%;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .header-logo__img {
      height: 2.5rem;
    }
  }

  main {
    min-height: 60vh;
  }

  main:focus {
    outline: none;
  }
</style>
