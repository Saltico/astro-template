---
// src/components/ui/HeroSection.astro
// Full-width hero section with background image/video support.
// La imagen de fondo es un <Img> absoluto con object-fit (NO background-image ni
// background-attachment: fixed). Es la imagen LCP: eager + fetchpriority high.
import Img from './Img.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  /** ImageMetadata (import de src/assets/img) o ruta '/img/x.avif'. */
  backgroundImage?: ImageMetadata | string;
  backgroundVideo?: string;
  poster?: string;
  overlay?: boolean;
  class?: string;
}

const {
  backgroundImage,
  backgroundVideo,
  poster,
  overlay = true,
  class: className,
} = Astro.props;
---

<section class:list={['hero', className]}>
  {backgroundVideo ? (
    <video
      autoplay
      muted
      loop
      playsinline
      poster={poster}
      class="hero__media"
    >
      <source src={backgroundVideo} type="video/mp4" />
    </video>
  ) : backgroundImage ? (
    <Img src={backgroundImage} alt="" class="hero__media" sizes="100vw" priority />
  ) : null}

  {overlay && <div class="hero__overlay" />}

  <div class="hero__content">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero :global(.hero__media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.8));
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: var(--breakpoint-xl);
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--spacing-4);
    padding-block: var(--spacing-16);
    text-align: center;
    color: var(--color-on-dark);
  }

  @media (min-width: 768px) {
    .hero__content {
      padding-inline: var(--spacing-8);
    }
  }

  .hero__content :global(h1),
  .hero__content :global(h2) {
    color: var(--color-on-dark);
    margin-bottom: var(--spacing-4);
  }

  .hero__content :global(p) {
    font-size: var(--text-lead);
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--spacing-8);
    color: rgba(241, 245, 249, 0.9);
  }
</style>
