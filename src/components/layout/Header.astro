---
// src/components/layout/Header.astro
// Sticky header with slots for logo, navigation, and CTA

export interface Props {
  variant?: 'default' | 'brand';
}

const { variant = 'default' } = Astro.props;
const headerClassList = ['header', variant === 'brand' && 'header--brand'];
---

<header class:list={headerClassList} role="banner" data-header>
  <div class="header__inner">
    <div class="header__logo">
      <slot name="logo">
        <a href="/" class="header__brand">Astro Template</a>
      </slot>
    </div>

    <div class="header__nav">
      <slot name="navigation" />
    </div>

    <div class="header__cta">
      <slot name="cta" />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    height: 72px;
    font-family: var(--font-body);
    color: var(--color-ink);
    transition: top 0.3s var(--ease-out),
      background-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }

  .header.is-scrolled {
    background-color: var(--color-surface);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-bottom-color: var(--color-line);
  }

  .header--brand {
    background-color: var(--color-brand);
    color: var(--color-on-brand);
  }

  :root[data-theme='dark'] .header.is-scrolled {
    background-color: var(--color-surface);
    border-bottom-color: var(--color-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4);
    max-width: var(--breakpoint-xl);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--spacing-4);
  }

  @media (min-width: 768px) {
    .header__inner {
      padding-inline: var(--spacing-8);
    }
  }

  .header__logo {
    flex-shrink: 0;
  }

  .header__brand {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .header__nav {
      justify-content: flex-end;
    }
  }

  /* Hide ThemeToggle from CTA on mobile — it lives inside the mobile drawer */
  @media (max-width: 1023px) {
    .header__cta :global([data-theme-toggle]) {
      display: none;
    }
  }

  .header__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>

<script>
  // Mark .is-scrolled when header separates from top
  (function () {
    if (typeof window === 'undefined') return;
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;

    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText =
      'position:absolute;top:0;left:0;width:100%;height:1px;pointer-events:none;';
    header.parentElement?.insertBefore(sentinel, header);

    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('is-scrolled', !entry.isIntersecting);
      },
      { threshold: [0, 1] }
    );
    observer.observe(sentinel);
  })();
</script>
