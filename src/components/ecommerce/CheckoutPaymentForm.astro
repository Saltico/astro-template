---
// src/components/ecommerce/CheckoutPaymentForm.astro
// Step 3: Payment information form

import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';

export interface Props {
  initialData?: {
    cardName?: string;
    cardNumber?: string;
    expiry?: string;
    cvv?: string;
  };
}

const { initialData = {} } = Astro.props;
---

<form class="checkout-payment" data-checkout-payment>
  <h2 class="checkout-payment__title">Payment Information</h2>

  <div class="checkout-payment__notice">
    <strong>Demo Mode:</strong> This is a template. No real payment processing. In production, integrate with Stripe, PayPal, or your payment provider.
  </div>

  <Input
    name="cardName"
    label="Name on Card"
    type="text"
    value={initialData.cardName}
    placeholder="John Doe"
    required
  />

  <Input
    name="cardNumber"
    label="Card Number"
    type="text"
    value={initialData.cardNumber}
    placeholder="4242 4242 4242 4242"
    required
    maxlength={19}
  />

  <div class="checkout-payment__row">
    <Input
      name="expiry"
      label="Expiry Date"
      type="text"
      value={initialData.expiry}
      placeholder="MM/YY"
      required
      maxlength={5}
    />
    <Input
      name="cvv"
      label="CVV"
      type="text"
      value={initialData.cvv}
      placeholder="123"
      required
      maxlength={4}
    />
  </div>

  <div class="checkout-payment__actions">
    <Button type="button" variant="outline" data-checkout-prev>
      Back
    </Button>
    <Button type="submit" variant="primary">
      Review Order
    </Button>
  </div>
</form>

<style>
  .checkout-payment {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .checkout-payment__title {
    font-size: var(--text-h3);
    margin: 0;
  }

  .checkout-payment__notice {
    padding: var(--spacing-4);
    background-color: var(--color-brand-050);
    border: 1px solid var(--color-brand);
    border-radius: var(--radius-md);
    font-size: var(--text-small);
    color: var(--color-ink-700);
  }

  .checkout-payment__notice strong {
    color: var(--color-brand);
  }

  .checkout-payment__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-4);
  }

  @media (min-width: 640px) {
    .checkout-payment__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .checkout-payment__actions {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-4);
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-line);
  }

  :root[data-theme='dark'] .checkout-payment__notice {
    background-color: color-mix(in srgb, var(--color-brand) 10%, transparent);
    border-color: var(--color-brand-600);
  }
</style>

<script>
  import { savePaymentData, getPaymentData } from '@/lib/checkout';

  // Load saved data
  const savedData = getPaymentData();
  if (savedData) {
    Object.entries(savedData).forEach(([key, value]) => {
      const input = document.querySelector(`[name="${key}"]`) as HTMLInputElement;
      if (input && !input.value) {
        input.value = value;
      }
    });
  }

  // Save on submit
  document.querySelector('[data-checkout-payment]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    savePaymentData(data as any);

    window.dispatchEvent(new CustomEvent('checkout-next'));
  });

  // Format card number (add spaces)
  document.querySelector('[name="cardNumber"]')?.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    let value = input.value.replace(/\s/g, '').replace(/\D/g, '');
    value = value.match(/.{1,4}/g)?.join(' ') || value;
    input.value = value;
  });

  // Format expiry (add slash)
  document.querySelector('[name="expiry"]')?.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    let value = input.value.replace(/\D/g, '');
    if (value.length >= 2) {
      value = value.slice(0, 2) + '/' + value.slice(2, 4);
    }
    input.value = value;
  });
</script>
