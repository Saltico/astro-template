---
// src/pages/404.astro
// 404 error page
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import Button from '@/components/ui/Button.astro';

const title = '404 - Page Not Found';
const description = 'The page you are looking for does not exist.';
---

<BaseLayout title={title} description={description} noindex>
  <SectionLayout background="default" spacing="lg">
    <Container size="sm">
      <div class="error-page">
        <h1 class="error-page__code">404</h1>
        <h2 class="error-page__title">Page Not Found</h2>
        <p class="error-page__description">
          The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
        </p>
        <Button variant="primary" href="/">Go to Homepage</Button>
      </div>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  .error-page {
    text-align: center;
    padding-block: var(--spacing-12);
  }

  .error-page__code {
    font-size: clamp(6rem, 15vw, 10rem);
    font-weight: 900;
    color: var(--color-brand);
    line-height: 1;
    margin-bottom: var(--spacing-4);
  }

  .error-page__title {
    font-size: var(--text-h2);
    margin-bottom: var(--spacing-4);
  }

  .error-page__description {
    font-size: var(--text-body);
    color: var(--color-ink-700);
    margin-bottom: var(--spacing-8);
    max-width: 400px;
    margin-inline: auto;
    line-height: 1.6;
  }
</style>
