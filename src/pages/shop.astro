---
// src/pages/shop.astro
// Shop page — product grid with add-to-cart

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import ProductCard from '@/components/ecommerce/ProductCard.astro';
import { products } from '@/data/products';

const title = 'Shop';
const description = 'Browse our collection of products.';
---

<BaseLayout title={title} description={description}>
  <PageHero title={title} description={description} />

  <SectionLayout background="default" spacing="lg">
    <Container size="xl">
      <div class="shop-grid">
        {products.map((product) => (
          <ProductCard
            id={product.id}
            name={product.name}
            price={product.price}
            image={product.image}
            description={product.description}
          />
        ))}
      </div>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-8);
  }
</style>
