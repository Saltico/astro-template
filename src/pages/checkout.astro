---
// src/pages/checkout.astro
// Checkout page — multi-step wizard (shipping → payment → review)

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import CheckoutWizard from '@/components/ecommerce/CheckoutWizard.astro';
import CheckoutShippingForm from '@/components/ecommerce/CheckoutShippingForm.astro';
import CheckoutPaymentForm from '@/components/ecommerce/CheckoutPaymentForm.astro';
import CheckoutReview from '@/components/ecommerce/CheckoutReview.astro';

const title = 'Checkout';
const description = 'Complete your order.';
const steps = ['Cart', 'Shipping', 'Payment', 'Review'];
---

<BaseLayout title={title} description={description} noindex>
  <SectionLayout background="default" spacing="lg">
    <Container size="lg">
      <CheckoutWizard steps={steps} currentStep={2}>
        <!-- Step panels rendered by client-side JS based on current step -->
        <div data-checkout-step="2" class="checkout-step">
          <CheckoutShippingForm />
        </div>
        <div data-checkout-step="3" class="checkout-step" hidden>
          <CheckoutPaymentForm />
        </div>
        <div data-checkout-step="4" class="checkout-step" hidden>
          <CheckoutReview />
        </div>
      </CheckoutWizard>
    </Container>
  </SectionLayout>
</BaseLayout>

<script>
  // Checkout wizard navigation
  let currentStep = 2;

  function showStep(step: number) {
    currentStep = step;

    // Hide all steps
    document.querySelectorAll('[data-checkout-step]').forEach((el) => {
      (el as HTMLElement).hidden = true;
    });

    // Show current step
    const currentPanel = document.querySelector(`[data-checkout-step="${step}"]`);
    if (currentPanel) {
      (currentPanel as HTMLElement).hidden = false;
    }

    // Update wizard nav
    const wizard = document.querySelector('[data-checkout-wizard]');
    if (wizard) {
      wizard.setAttribute('data-current-step', step.toString());
    }

    // Update step indicators
    document.querySelectorAll('.checkout-wizard__step').forEach((el, index) => {
      const stepNum = index + 1;
      el.classList.remove('checkout-wizard__step--active', 'checkout-wizard__step--completed');
      if (stepNum === step) {
        el.classList.add('checkout-wizard__step--active');
      } else if (stepNum < step) {
        el.classList.add('checkout-wizard__step--completed');
      }
    });
  }

  // Next button (from shipping/payment forms)
  window.addEventListener('checkout-next', () => {
    if (currentStep < 4) {
      showStep(currentStep + 1);
    }
  });

  // Prev button
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).hasAttribute('data-checkout-prev')) {
      if (currentStep > 2) {
        showStep(currentStep - 1);
      }
    }
  });

  // Initialize
  showStep(2);
</script>
