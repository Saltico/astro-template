---
// src/pages/blog/index.astro
// Blog listing page
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = 'Blog';
const description = 'Latest articles and updates from our team.';
---

<BaseLayout title={title} description={description}>
  <PageHero title={title} description={description} />

  <SectionLayout background="default" spacing="md">
    <Container size="lg">
      {posts.length === 0 ? (
        <div class="empty-state">
          <p>No posts yet. Check back soon!</p>
          <p class="hint">
            To add your first post, visit <a href="/keystatic">/keystatic</a> (in dev mode) and create a new entry in the "Posts" collection.
          </p>
        </div>
      ) : (
        <div class="post-grid">
          {posts.map((post) => (
            <article class="post-card">
              <a href={`/blog/${post.slug}/`}>
                <time class="post-card__date" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <h2 class="post-card__title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="post-card__description">{post.data.description}</p>
                )}
              </a>
            </article>
          ))}
        </div>
      )}
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  .empty-state {
    text-align: center;
    padding: var(--spacing-12) var(--spacing-4);
  }

  .empty-state p {
    font-size: var(--text-body);
    color: var(--color-ink-700);
    margin-bottom: var(--spacing-4);
  }

  .empty-state .hint {
    font-size: var(--text-small);
    color: var(--color-ink-500);
  }

  .empty-state a {
    color: var(--color-brand);
    text-decoration: underline;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-6);
  }

  .post-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s var(--ease-out);
    border: 1px solid var(--color-line);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .post-card a {
    display: block;
    padding: var(--spacing-6);
    text-decoration: none;
    color: inherit;
  }

  .post-card__date {
    display: block;
    font-size: var(--text-small);
    color: var(--color-ink-500);
    margin-bottom: var(--spacing-3);
  }

  .post-card__title {
    font-size: var(--text-h4);
    margin-bottom: var(--spacing-3);
    color: var(--color-ink);
    line-height: 1.3;
  }

  .post-card__description {
    font-size: var(--text-body);
    color: var(--color-ink-700);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :root[data-theme='dark'] .post-card {
    background-color: var(--color-graphite-2);
    border-color: var(--color-line-dark);
  }

  :root[data-theme='dark'] .post-card__title {
    color: var(--color-on-dark);
  }

  :root[data-theme='dark'] .post-card__description {
    color: var(--color-on-dark-muted);
  }
</style>
