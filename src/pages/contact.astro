---
// src/pages/contact.astro
// Contact page with a configurable form endpoint.
// PUBLIC_FORM_ACTION env var points to an external service (Formspree, Getform, etc.)
// Falls back to mailto: when no endpoint is configured.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Input from '@/components/ui/Input.astro';
import Textarea from '@/components/ui/Textarea.astro';
import Button from '@/components/ui/Button.astro';
import { siteContact, siteBrand } from '@/data/site';

const title = 'Contacto';
const description = `Ponte en contacto con ${siteBrand.name}. Estaremos encantados de atenderte.`;

const formAction = import.meta.env.PUBLIC_FORM_ACTION ?? '';
const useMailto = !formAction && siteContact.email;
const mailtoAction = useMailto ? `mailto:${siteContact.email}` : '';
const isExternal = !!formAction;
---

<BaseLayout title={title} description={description}>
  <PageHero title={title} description={description} />

  <SectionLayout background="default" spacing="lg">
    <Container size="lg">
      <div class="contact-grid">
        <!-- Contact info sidebar -->
        <aside class="contact-info">
          <h2 class="contact-info__title">Ponte en contacto</h2>
          <p class="contact-info__text">
            Estaremos encantados de atenderte. Rellena el formulario y te responderemos lo antes posible.
          </p>

          <div class="contact-info__details">
            {siteContact.email && (
              <div class="contact-info__item">
                <span class="contact-info__label">Email</span>
                <a href={`mailto:${siteContact.email}`} class="contact-info__value">
                  {siteContact.email}
                </a>
              </div>
            )}

            {siteContact.phone && (
              <div class="contact-info__item">
                <span class="contact-info__label">Teléfono</span>
                <a href={`tel:${siteContact.phone.replace(/\s/g, '')}`} class="contact-info__value">
                  {siteContact.phone}
                </a>
              </div>
            )}

            {siteContact.address && (
              <div class="contact-info__item">
                <span class="contact-info__label">Dirección</span>
                <span class="contact-info__value">{siteContact.address}</span>
              </div>
            )}

            {siteContact.schedule && (
              <div class="contact-info__item">
                <span class="contact-info__label">Horario</span>
                <span class="contact-info__value">{siteContact.schedule}</span>
              </div>
            )}

            {siteContact.mapsEmbedUrl && (
              <div class="contact-info__item">
                <iframe
                  src={siteContact.mapsEmbedUrl}
                  width="100%"
                  height="200"
                  style="border:0; border-radius: var(--radius-md);"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Ubicación"
                />
              </div>
            )}
          </div>
        </aside>

        <!-- Contact form -->
        <form
          class="contact-form"
          data-contact-form
          method={isExternal ? 'POST' : undefined}
          action={isExternal ? formAction : mailtoAction || undefined}
        >
          <div class="contact-form__row">
            <Input
              name="firstName"
              label="Nombre"
              type="text"
              placeholder="Juan"
              required
              autocomplete="given-name"
            />
            <Input
              name="lastName"
              label="Apellido"
              type="text"
              placeholder="Pérez"
              required
              autocomplete="family-name"
            />
          </div>

          <div class="contact-form__row">
            <Input
              name="email"
              label="Email"
              type="email"
              placeholder="juan@ejemplo.com"
              required
              autocomplete="email"
            />
            <Input
              name="phone"
              label="Teléfono"
              type="tel"
              placeholder="+56 9 1234 5678"
              autocomplete="tel"
            />
          </div>

          <Input
            name="subject"
            label="Asunto"
            type="text"
            placeholder="¿En qué podemos ayudarte?"
            required
          />

          <Textarea
            name="message"
            label="Mensaje"
            placeholder="Cuéntanos más sobre tu consulta..."
            rows={6}
            required
          />

          <div class="contact-form__actions">
            <Button type="submit" variant="primary" size="lg">
              Enviar mensaje
            </Button>
          </div>

          <!-- Success message (hidden by default) -->
          <div class="contact-form__success" data-contact-success hidden>
            <div class="contact-form__success-icon">✓</div>
            <h3 class="contact-form__success-title">¡Mensaje enviado!</h3>
            <p class="contact-form__success-text">
              Gracias por contactarnos. Te responderemos dentro de las próximas 24 horas.
            </p>
          </div>
        </form>
      </div>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-12);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 2fr;
      gap: var(--spacing-16);
      align-items: start;
    }
  }

  .contact-info__title {
    font-size: var(--text-h3);
    margin-bottom: var(--spacing-4);
  }

  .contact-info__text {
    color: var(--color-ink-700);
    line-height: 1.6;
    margin-bottom: var(--spacing-8);
  }

  .contact-info__details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .contact-info__item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .contact-info__label {
    font-family: var(--font-heading);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-500);
  }

  .contact-info__value {
    font-size: var(--text-body);
    color: var(--color-ink);
    line-height: 1.6;
  }

  a.contact-info__value {
    color: var(--color-brand);
    text-decoration: none;
  }

  a.contact-info__value:hover {
    text-decoration: underline;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  @media (min-width: 480px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-form__actions {
    display: flex;
    justify-content: flex-end;
  }

  .contact-form__success {
    text-align: center;
    padding: var(--spacing-8);
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-lg);
    margin-top: var(--spacing-4);
  }

  .contact-form__success[hidden] {
    display: none;
  }

  .contact-form__success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background-color: var(--color-success);
    color: #fff;
    border-radius: var(--radius-pill);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--spacing-4);
  }

  .contact-form__success-title {
    font-size: var(--text-h4);
    margin-bottom: var(--spacing-2);
    color: var(--color-ink);
  }

  .contact-form__success-text {
    color: var(--color-ink-700);
    line-height: 1.6;
  }

  :root[data-theme='dark'] .contact-info__text,
  :root[data-theme='dark'] .contact-info__value,
  :root[data-theme='dark'] .contact-form__success-text {
    color: var(--color-ink-700);
  }
</style>

<script>
  (function () {
    const form = document.querySelector('[data-contact-form]');
    const success = document.querySelector('[data-contact-success]');
    if (!form || !success) return;

    const hasExternalAction = form.hasAttribute('action') && form.getAttribute('method') === 'POST';

    if (hasExternalAction) {
      return;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      (form as HTMLFormElement).style.display = 'none';
      success.hidden = false;
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  })();
</script>
