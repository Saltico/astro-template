---
// src/pages/cart.astro
// Cart page — view cart items and proceed to checkout

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CartSummary from '@/components/ecommerce/CartSummary.astro';

const title = 'Shopping Cart';
const description = 'Review your items before checkout.';
---

<BaseLayout title={title} description={description}>
  <PageHero title={title} description={description} />

  <SectionLayout background="default" spacing="lg">
    <Container size="md">
      <CartSummary variant="full" showActions={true} />
    </Container>
  </SectionLayout>
</BaseLayout>
