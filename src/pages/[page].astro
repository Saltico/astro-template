---
// src/pages/[page].astro
// Dynamic pages from content collection
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { getSiteUrl } from '@/lib/seo';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { page: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: CollectionEntry<'pages'> };
const { Content } = await page.render();

const title = page.data.title;
const description = page.data.description || '';
const noindex = page.data.noindex;
const canonical = getSiteUrl(`/${page.slug}/`);
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={noindex}>
  <PageHero title={title} description={description} />

  <SectionLayout background="default" spacing="md">
    <Container size="lg">
      <div class="page-content">
        <Content />
      </div>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  .page-content {
    max-width: 720px;
    margin-inline: auto;
    font-size: var(--text-body);
    line-height: 1.7;
  }

  .page-content :global(h2) {
    font-size: var(--text-h3);
    margin-top: var(--spacing-8);
    margin-bottom: var(--spacing-4);
  }

  .page-content :global(h3) {
    font-size: var(--text-h4);
    margin-top: var(--spacing-6);
    margin-bottom: var(--spacing-3);
  }

  .page-content :global(p) {
    margin-bottom: var(--spacing-4);
  }

  .page-content :global(ul),
  .page-content :global(ol) {
    margin-bottom: var(--spacing-4);
    padding-left: var(--spacing-6);
  }

  .page-content :global(li) {
    margin-bottom: var(--spacing-2);
  }

  .page-content :global(blockquote) {
    margin-block: var(--spacing-6);
    padding-left: var(--spacing-6);
    border-left: 4px solid var(--color-brand);
    font-style: italic;
    color: var(--color-ink-700);
  }
</style>
