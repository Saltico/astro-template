# Canonical site URL (drives sitemap, canonicals, OG URLs)
PUBLIC_SITE_URL=https://example.com

# Site language (ISO 639-1, e.g. es, en, pt)
PUBLIC_SITE_LANG=es

# Google Tag Manager ID — leave empty to omit GTM entirely.
# GTM TAKES PRIORITY: if set, direct GA4 (gtag.js) is NOT injected, even if
# PUBLIC_GA4_ID is also set. Configure GA4 inside the GTM container.
PUBLIC_GTM_ID=

# Google Analytics 4 ID — direct gtag.js snippet, ONLY used when PUBLIC_GTM_ID is empty
# (avoids double counting). Leave empty to omit gtag entirely.
PUBLIC_GA4_ID=

# Consent: if PUBLIC_GTM_ID or PUBLIC_GA4_ID is set, the template renders the consent default
# (Consent Mode v2, all denied), an explanatory banner (no cookies page) and a
# "Preferencias de cookies" button in the footer to reopen it. With no IDs, none of it renders.

# Contact data — used as fallback when Keystatic CMS is not active
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_MAPS_EMBED_URL=

# Contact form endpoint — external service URL (Formspree, Getform, etc.)
# Leave empty to use mailto: fallback with PUBLIC_CONTACT_EMAIL
PUBLIC_FORM_ACTION=

# Keystatic CMS — set to true in dev mode to enable the CMS UI at /keystatic
ASTRO_ENABLE_KEYSTATIC=false

# i18n — comma-separated locale codes (e.g. es,en). Leave empty to disable i18n routing.
PUBLIC_I18N_LOCALES=
