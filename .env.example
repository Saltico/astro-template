# Canonical site URL (drives sitemap, canonicals, OG URLs)
PUBLIC_SITE_URL=https://example.com

# Google Tag Manager ID — leave empty to omit GTM entirely
PUBLIC_GTM_ID=

# Google Analytics 4 ID — leave empty to omit gtag entirely
PUBLIC_GA_ID=

# WordPress headless (optional — see migration docs in README)
# WP_API_URL=https://cms.example.com/wp-json

# SMTP (for order confirmation emails)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# ORDER_EMAIL_FROM=orders@example.com
# ORDER_EMAIL_TO=admin@example.com
